{
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@playwright/test": "^1.61.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "http-server": "^14.1.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "pdf-lib": "^1.17.1"
  },
  "scripts": {
    "postinstall": "playwright install --with-deps",
    "test:unit": "jest",
    "test:update-snapshots": "npx playwright test --update-snapshots",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "render:prints": "node scripts/render-prints.js",
    "thumbs": "node scripts/fetch-thumbs.js",
    "thumbs:check": "node scripts/fetch-thumbs.js --check",
    "sync:title": "node scripts/sync-title.js",
    "impose:booklet": "node scripts/impose-booklet.js",
    "agent:content": "node scripts/content-agent.js",
    "agent:notes": "node scripts/notes-to-blocks.js",
    "agent:typos": "node scripts/typo-review.js",
    "agent:followup": "node scripts/video-followup.js",
    "study:report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/study-report.js",
    "transcripts": "node scripts/fetch-transcripts.js",
    "transcripts:check": "node scripts/fetch-transcripts.js --check",
    "transcripts:translate": "node scripts/translate-transcripts.js"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testPathIgnorePatterns": [
      "/e2e/"
    ]
  }
}
